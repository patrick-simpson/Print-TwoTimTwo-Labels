            "club": "Cubbies",
            "isBirthday": false,
            "isFirstTimer": false,
            "allergies": "peanuts",
            "phone": "555-0100"
          },
          "mustNotContain": [
            "allergies",
            "peanuts",
            "phone",
            "555-0100"
          ]
        }
      ],
      "reject": [
        {
          "reason": "missing firstName",
          "payload": {
            "club": "Sparks",
            "isBirthday": false,
            "isFirstTimer": false
          }
        },
        {
          "reason": "non-object",
          "payload": "Alice checked in"
        },
        {
          "reason": "null",
          "payload": null
        }
      ]
    },
