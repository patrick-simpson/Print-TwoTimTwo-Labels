{
  "contractVersion": 4,
  "channel": "awana-channel",
  "note": "CANONICAL COPY (Print-TwoTimTwo-Labels). Mirrored byte-identical into the consumer repos (Awana-Check-in-Display, KVBC-Awana-Countdown). Privacy rule: only first names ever ride the channel — no lastName, no allergies, no contact info, no birth years. v3 adds four PII-free aggregate/context events sourced from TwoTimTwo's own reports: tonight (counters), points (color-team scores), schedule (next meeting), notice (church-authored public announcement — the only free-text field on the channel, bounded and plain-text-forced).",
  "transport": {
    "note": "The Pusher channel is PUBLIC and Pusher public channels have no server-side authorization primitive, so the three name-bearing events are sealed with AES-256-GCM before publish. This is a TRANSPORT change only: every payload vector below is unchanged, and both repos' sanitizers run on the OPENED payload exactly as before. The framing, padding sizes and a cross-implementation interop fixture live in envelope-vectors.json, which is mirrored byte-identically into the display repo alongside this file.",
    "encryptedEvents": [
      "checkin",
      "recap",
      "birthdays",
      "checkout"
    ],
    "plaintextEvents": [
      "tally",
      "tonight",
      "points",
      "schedule",
      "notice",
      "ops",
      "canary"
    ],
    "plaintextRationale": "Deliberate. Counts and church-authored copy carry no PII, and their readability is what lets a screen distinguish \"the pipe is down\" from \"I cannot read the names\" from \"quiet night\" — the last being the dangerous case, because nobody investigates a quiet night.",
    "fixture": "envelope-vectors.json"
  },
  "events": {
    "checkin": {
