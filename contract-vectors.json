            "firstName": "Alice",
            "lastName": "Smith",
            "club": "Sparks",
            "isBirthday": false,
            "isFirstTimer": false
          },
          "mustNotContain": [
            "lastName",
            "Smith"
          ]
        },
        {
          "reason": "allergy / contact info must never leak",
