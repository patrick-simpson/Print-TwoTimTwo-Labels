          "payload": {
            "entries": "Amy",
            "at": "2026-09-16T23:55:00.000Z"
          }
        },
        {
          "reason": "a missing entries array is not an empty board",
          "payload": {
            "printed": 43,
            "at": "2026-09-16T23:55:00.000Z"
          }
        },
        {
          "reason": "at is required so a consumer can age out a stale board",
          "payload": {
            "entries": []
          }
        },
        {
          "reason": "not an object",
          "payload": "Amy"
        }
