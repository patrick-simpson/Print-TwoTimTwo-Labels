    "slides": {
      "note": "The lobby displays' typed slide deck (contract v5), published by the operator so every screen shows one deck. TEXT ONLY by contract: the display app's per-device video slides reference bytes in that device's own storage, so the publisher strips them and the consumer's sanitizer drops them. One publish is split into chunks so a large deck stays under Pusher's per-message ceiling; every chunk of a publish carries identical {deckRev, publishedAt}. publishedAt is the consumer's ONLY ordering and anti-replay authority — a deck commits iff its publishedAt is strictly newer than the committed one — because deckRev is an operator-facing counter that may restart at 1 if the publisher loses its state file. An explicitly published EMPTY deck (slides:[] with total:1) propagates: 'the operator cleared the deck' and 'never received a deck' are different facts. The publisher refuses (at publish time, before committing) any deck that cannot be broadcast within maxTotal chunks, and additionally caps a whole deck's serialized JSON at 40000 bytes.",
      "fields": [
        "deckRev",
        "publishedAt",
        "seq",
        "total",
        "slides"
      ],
      "entryFields": [
        "eyebrow",
        "text",
        "theme",
        "textSize",
        "durationSec"
      ],
      "entryOptionalFields": [
        "id"
      ],
      "maxEntries": 50,
      "maxTotal": 12,
      "maxText": 500,
      "maxEyebrow": 60,
      "themes": [
        "sky",
        "sunset",
        "night",
        "meadow",
        "lavender"
      ],
